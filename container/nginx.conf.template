worker_processes auto;
pid /tmp/haven/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  access_log /dev/stdout;
  client_body_temp_path /tmp/haven/client;
  proxy_temp_path /tmp/haven/proxy;
  fastcgi_temp_path /tmp/haven/fastcgi;
  uwsgi_temp_path /tmp/haven/uwsgi;
  scgi_temp_path /tmp/haven/scgi;
  # Match API transport: 1 MiB document plus 4 KiB candidate metadata.
  # The API separately enforces each document's original 1 MiB budget.
  client_max_body_size 1028k;
  # Mutations require the exact browser origin. No CORS credential bridge is exposed.
  map "$request_method:$http_origin" $reject_origin {
    default 1;
    ~^(GET|HEAD): 0;
    "POST:${HAVEN_PUBLIC_ORIGIN}" 0;
    "PUT:${HAVEN_PUBLIC_ORIGIN}" 0;
    "PATCH:${HAVEN_PUBLIC_ORIGIN}" 0;
    "DELETE:${HAVEN_PUBLIC_ORIGIN}" 0;
  }
  server {
    listen 8080;
    root /usr/share/nginx/html;
    add_header_inherit merge;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
    location = /healthz { access_log off; return 200 'ok'; }
    location ^~ /api/ {
      if ($reject_origin) { return 403; }
      proxy_pass http://${HAVEN_API_UPSTREAM};
      proxy_set_header Authorization "Bearer ${HAVEN_API_TOKEN}";
      proxy_set_header Cookie "";
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_connect_timeout 5s;
      proxy_read_timeout 30s;
      proxy_buffering off;
      add_header Cache-Control no-store always;
    }
    location = /index.html { add_header Cache-Control no-store; }
    location ~* \.(js|css|woff2?)$ {
      try_files $uri =404;
      add_header Cache-Control 'public, max-age=31536000, immutable';
    }
    location ~ /\. { return 404; }
    location ~* \.json$ {
      try_files $uri =404;
      add_header Cache-Control no-cache always;
    }
    location / { try_files $uri $uri/ /index.html; }
  }
}
