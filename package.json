{
  "name": "haven-studio",
  "version": "0.1.0-dev.1",
  "scripts": {
    "prepare": "husky",
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "lint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint && stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "check": "pnpm check:retirement && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:ci": "pnpm check",
    "check:retirement": "node tools/check-retirement.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@haven/runtime": "0.1.0-dev.30",
    "@haven/schema": "0.1.0-dev.30",
    "@haven/ui": "0.1.0-dev.30",
    "@jsverse/transloco": "8.4.0",
    "@tanstack/angular-table": "9.3.1",
    "@tanstack/angular-virtual": "6.1.12",
    "dompurify": "3.4.17",
    "quill": "2.0.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "29.0.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.18.0 <13"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --write",
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HaltCatch/haven-studio.git"
  }
}
